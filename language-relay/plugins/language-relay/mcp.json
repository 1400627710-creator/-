{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "language-relay": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/skills/language-relay/scripts/relay_tool.py",
        "--workspace",
        "${PLUGIN_DATA}/language-relay",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
